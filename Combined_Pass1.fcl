#include "Offline/CRVResponse/fcl/prolog.fcl"
#include "PassN/Tracker/TrkRecoFromFragments.fcl"

physics.producers : {
    @table::physics.producers
    @table::CaloReco.producers
    @table::CaloCluster.producers
    CaloDigis : @local::DAQ.producers.CaloDigis
    CrvDigi :
    {
      module_type   : CrvDigisFromArtdaqFragmentsFEBII
      diagLevel     : 0
      useROC4asROC2 : true
    }
    CrvRecoPulses: @local::CrvRecoPulses
    CrvCoincidenceClusterFinder: @local::CrvCoincidenceClusterFinder
    MSDHitMaker : {
      module_type: MSDHitsFromDTCEvents
      debugLevel: 0
    }
  }
physics.analyzers : {
    CrvDQMcollector: @local::CrvDQMcollector
  }
physics.CaloRecoPath : [ CaloDigis, CaloRecoDigiMaker, CaloHitMaker, CaloProtoClusterMaker, CaloClusterMaker ]
physics.CRVRecoPath : [ CrvDigi, CrvRecoPulses, CrvCoincidenceClusterFinder ]
physics.RecoPath : [ CaloDigis, CaloRecoDigiMaker, CaloHitMaker, CaloProtoClusterMaker, CaloClusterMaker, @sequence::physics.RecoPath ]
physics.CRVEndPath : [ CrvDQMcollector ]
physics.MSDRecoPath : [ EWMProducer, MSDHitMaker ]
physics.trigger_paths  : [RecoPath, CaloRecoPath, CRVRecoPath, MSDRecoPath]
physics.end_paths : [CRVEndPath, EndPath]

outputs.KinematicLineOutput.SelectEvents : []
outputs.KinematicLineOutput.outputCommands : [ "drop *_*_*_*",
      @sequence::Reconstruction.GeneralProducts,
      @sequence::Reconstruction.HighRecoProducts,
      @sequence::Reconstruction.MidRecoProducts,
      "keep *_DummyLumiInfo_*_*",
      "keep *_TriggerResults_*_*",
      "keep mu2e::CrvRecoPulses_*_*_*",
      "keep mu2e::CrvDigis_*_*_*",
      "keep mu2e::CrvDAQerrors_*_*_*",
      "keep *_EWMProducer_*_*",
      "keep mu2e::CrvCoincidenceClusters_*_*_*",
      "keep mu2e::CrvStatuss_*_*_*",
      "drop artdaq::*_*_*_*" ,
      "drop mu2e::CrvDigis_*_NZS_*",
      "keep *_MSDHitMaker_*_*"
    ]

# measured detector positions (geom_common_commissioning_v02.txt, renamed extracted v06 in Offline#2082)
services.GeometryService.inputFile : "Offline/Mu2eG4/geom/geom_common_extracted_v06.txt"

### CALO CONFIG ###
#Real data
physics.producers.CaloRecoDigiMaker.caloDigiCollection : CaloDigis
# for combined runs turn on calo in kkline
physics.producers.KKLine.KKFitSettings.UseCaloCluster : true
physics.producers.LineFinder.AddCaloClusters: true

#No beam
physics.producers.CaloRecoDigiMaker.UseProtonBunchTime : false

#Use database
services.ProditionsService.calCalib.useDb : true

### CRV CONFIG ###
#include "Offline/CRVReco/fcl/epilog_extracted.fcl"
physics.producers.CrvCoincidenceClusterFinder.ignoreSecondaryPulses : true  //ignore secondary pulses in a waveform
services.ProditionsService.crvStatus.useDb : true
services.ProditionsService.crvCalib.useDb  : true
services.ProditionsService.eventTiming.useDb  : true

# temporary calibrations
#include "PassN/Tracker/trackercalibrations.fcl"

# for now hard code KPP_reco purpose with most recent version
services.DbService.purpose : "KPP_reco"
services.DbService.version: ""
# services.DbService.textFile : []
# for now fall back to the nearest earlier IOV for runs without calibraitons
services.DbService.nearestMatch : true
