# EventHeader, EventWindowMarker and ProtonBunchTime from the CFO fragment, decoded as in the trigger.
# Without CFO data it puts a default (off-spill, PBT = 0) marker and header, and warns
physics.producers.EWMProducer: @local::TrigDAQProducers.EWMProducer
physics.producers.makeSD: {
          module_type: StrawDigisFromArtdaqFragments
          saveWaveforms : true
          diagLevel     : 0  # not used yet
          missingDTCHeaders : false
          debugBits: []
          debugMode: 0
          addressing: "byMnid"
          onMissingRow: "skip"
      }

services.RandomNumberGenerator   : { defaultEngineKind: "MixMaxRng" }
services.SeedService                    : @local::automaticSeeds
services.SeedService.baseSeed : 8

physics.RecoPath: [
  makeSD,
  EWMProducer,
  @sequence::physics.RecoPath
]

services.ProditionsService.trackerPanelMap.useDb : true
